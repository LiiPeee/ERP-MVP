        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Renova a sessão com o refresh token do cookie (exige o cabeçalho CSRF)",
        "tags" : [ "Auth" ]
      }
    },
