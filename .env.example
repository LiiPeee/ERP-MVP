# Copie este arquivo para .env e troque todos os valores.
# O .env nunca entra no repositório. Os valores abaixo são falsos e só servem para desenvolvimento local.

ERP_DB_NAME=erp

# Superusuário do PostgreSQL: usado só na criação do banco e dos papéis.
ERP_DB_SUPERUSER=postgres
ERP_DB_SUPERUSER_PASSWORD=dev-only-superuser-change-me

# Papel das migrações Flyway: dono do banco.
ERP_DB_MIGRATOR_USER=erp_migrator
ERP_DB_MIGRATOR_PASSWORD=dev-only-migrator-change-me

# Papel da aplicação: sem posse, sem superusuário, sujeito a Row Level Security.
ERP_DB_APP_USER=erp_app
ERP_DB_APP_PASSWORD=dev-only-app-change-me
