# Copie este arquivo para .env e troque todos os valores.
# O .env nunca entra no repositório. Os valores abaixo são falsos e só servem para desenvolvimento local.

ERP_DB_NAME=erp

# Superusuário do PostgreSQL: usado só na criação do banco e dos papéis.
ERP_DB_SUPERUSER=postgres
ERP_DB_SUPERUSER_PASSWORD=dev-only-superuser-change-me

# Papel das migrações Flyway: dono do banco.
ERP_DB_MIGRATOR_USER=erp_migrator
ERP_DB_MIGRATOR_PASSWORD=dev-only-migrator-change-me

# Papel da aplicação: sem posse, sem superusuário, sujeito a Row Level Security.
ERP_DB_APP_USER=erp_app
ERP_DB_APP_PASSWORD=dev-only-app-change-me

# Chave de assinatura do token de acesso: HMAC-SHA256, em Base64, com no mínimo 32 bytes.
# Gere uma nova e secreta para cada ambiente: openssl rand -base64 48
# O valor abaixo é falso e só serve para desenvolvimento local.
ERP_SECURITY_JWT_ACTIVE_KEY_ID=k1
ERP_SECURITY_JWT_KEYS_K1=ZGV2LW9ubHktY2hhbmdlLW1lLXNpZ25pbmcta2V5LXdpdGgtYXQtbGVhc3QtMzItYnl0ZXM=

# Criptografia de campo (telefone, e-mail, placa). Valores falsos de desenvolvimento: troque em qualquer ambiente real.
# Chave de cifrar: AES-256, exatamente 32 bytes em Base64. Várias podem existir; a ACTIVE cifra e todas decifram (rotação).
ERP_SECURITY_FIELD_ENCRYPTION_ACTIVE_KEY_ID=k1
ERP_SECURITY_FIELD_ENCRYPTION_KEYS_K1=ZGV2LW9ubHktZmllbGQtZW5jcnlwdGlvbi1rZXktMzI=
# Chave do índice cego (HMAC): no mínimo 32 bytes em Base64. Não tem rotação: trocar exige reindexar.
ERP_SECURITY_FIELD_BLIND_INDEX_KEY=ZGV2LW9ubHktYmxpbmQtaW5kZXgta2V5LTAxMjM0NTY3ODk=
